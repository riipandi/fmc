{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PostToolUse": [
            {
                "hooks": [
                    {
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
                        "type": "command"
                    }
                ],
                "matcher": "Edit|Write"
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(just)",
            "Bash(just *)",
            "Bash(cargo *)",
            "Bash(git *)",
            "Bash(gh *)"
        ],
        "ask": [
            "Edit(/Cargo.toml)",
            "Edit(/rust-toolchain.toml)",
            "Edit(/.cargo/config.toml)",
            "Bash(cargo add *)",
            "Bash(cargo remove *)",
            "Bash(cargo install *)",
            "Bash(git push * --delete *)",
            "Bash(git push * :*)",
            "Bash(git branch -D *)",
            "Bash(git tag -d *)",
            "Bash(git rebase *)",
            "Bash(git filter-branch *)",
            "Bash(gh pr merge *)",
            "Bash(gh pr close *)",
            "Bash(gh release create *)",
            "Bash(gh release edit *)",
            "Bash(gh workflow run *)",
            "Bash(gh secret *)",
            "Bash(gh variable *)",
            "Bash(gh api *)"
        ],
        "deny": [
            "Bash(git push --force*)",
            "Bash(git push * --force*)",
            "Bash(git push -f*)",
            "Bash(git push * -f*)",
            "Bash(git push * +*)",
            "Bash(git reset --hard*)",
            "Bash(git checkout .*)",
            "Bash(git checkout -- .*)",
            "Bash(git restore .*)",
            "Bash(git clean *)",
            "Bash(git stash*)",
            "Bash(git commit * --no-verify*)",
            "Bash(git commit --no-verify*)",
            "Bash(git commit * -n *)",
            "Bash(git gc --prune*)",
            "Bash(git reflog expire *)",
            "Bash(git update-ref -d *)",
            "Bash(gh repo delete *)",
            "Bash(gh repo archive *)",
            "Bash(gh repo edit *)",
            "Bash(gh release delete *)",
            "Bash(gh run delete *)",
            "Bash(gh cache delete *)",
            "Bash(gh auth *)",
            "Bash(gh ssh-key *)",
            "Bash(gh gpg-key *)"
        ]
    }
}
