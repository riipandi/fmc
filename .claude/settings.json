{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PostToolUse": [
            {
                "hooks": [
                    {
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
                        "type": "command"
                    }
                ],
                "matcher": "Edit|Write"
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(just)",
            "Bash(just *)",
            "Bash(cargo *)"
        ],
        "ask": [
            "Edit(/Cargo.toml)",
            "Edit(/rust-toolchain.toml)",
            "Edit(/.cargo/config.toml)",
            "Bash(cargo add *)",
            "Bash(cargo remove *)",
            "Bash(cargo install *)",
            "Bash(git push *)"
        ]
    }
}
